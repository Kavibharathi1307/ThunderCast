{
  "rewrites": [
    {
      "source": "/((?!.*\\.(svg|png|jpg|jpeg|gif|ico|webp|css|js|woff2?|ttf|otf|json)$).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
