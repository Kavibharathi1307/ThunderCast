# Base URL of the ThunderCast AI backend API.
# Local dev default. In production (Vercel) set this to the Render backend URL.
#
# Preferred production variable (used first if set):
VITE_API_BASE_URL=http://localhost:8000
# Backward-compatible alias (used only when VITE_API_BASE_URL is unset):
VITE_API_URL=http://localhost:8000
